    {"id":"agarwood","zh":"沉香","latin":"Aquilaria spp. resinous wood","era":"《陈氏香谱》直接记载","molecules":[["alpha-pinene",0.15],["beta-caryophyllene",0.20],["caryophyllene oxide",0.15],["agarospirol",0.25],["cubenol/eudesmol family",0.25]],"vector":[0.90,0.80,0.30,0.10,0.20,0.10,0.10,0.60,0.50,0.20,0.05,0.90],"sources":["ctext","agarwood_gc1","agarwood_gc2"],"note":"产地、结香方式和提取法造成巨大化学型差异；向量代表宽泛共有轮廓。"},
    {"id":"sandalwood","zh":"檀香","latin":"Santalum album","era":"《陈氏香谱》直接记载","molecules":[["alpha-santalol",0.55],["beta-santalol",0.35],["minor sesquiterpenes",0.10]],"vector":[1.00,0.40,0.50,0.15,0.10,0.05,0.15,0.20,0.10,0.15,0.05,0.90],"sources":["ctext","sandalwood_gc","pyrfume"],"note":"以α/β-santalol为主的木质、柔和且持久轮廓。"},
